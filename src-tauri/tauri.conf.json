{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenOrbit",
  "version": "0.2.0",
  "identifier": "io.github.wjacobs20301.openorbit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenOrbit",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Reference",
    "shortDescription": "Open-source desktop globe built on public map data",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2NjY0MjdGRjhBRDQwRDgKUldUWVFLMzRmMEptbHNzMFhvUmtabXJVUTdzeXFhZzlRU1VNUnJVR081UVkwdTFESkNKTWZReVMK",
      "endpoints": [
        "https://github.com/wjacobs20301/openorbit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
